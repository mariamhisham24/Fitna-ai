# ============================================
# Fitna AI — Environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file with real keys.
# ============================================

# Supabase project (Settings → API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. Bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Groq (console.groq.com) — Llama 3.3 70B for student agents + analysis,
# Whisper large-v3 for Egyptian Arabic speech-to-text. Free tier.
GROQ_API_KEY=

# Resend (resend.com) — transactional email: teacher invites, password reset.
# Free tier: 100 emails/day, 3000/month, no domain verification needed
# for the resend.dev sandbox sender while testing.
RESEND_API_KEY=

# Hugging Face (huggingface.co/settings/tokens) — optional fallback
# Arabic STT model if Groq Whisper is unavailable.
HUGGINGFACE_API_KEY=

# Public URL of this app (used in email links, share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
